# UE-matched gn args for building the V8 monolith for UnrealJs (Android).
# Template: Build-V8-Android.sh substitutes @TARGET_CPU@, @NDK_ROOT@, @NDK_VERSION@, @API_LEVEL@.
# These MUST stay in sync with the ABI defines in Source/V8/V8.Build.cs
# (V8_COMPRESS_POINTERS / V8_31BIT_SMIS_ON_64BIT_ARCH /
#  V8_COMPRESS_POINTERS_IN_SHARED_CAGE) or every V8 handle silently corrupts.
target_os = "android"
target_cpu = "@TARGET_CPU@"
android_ndk_root = "@NDK_ROOT@"      # the NDK UE builds with (r27c for UE 5.8), not V8's bundled one
android_ndk_version = "@NDK_VERSION@"
android_ndk_api_level = @API_LEVEL@  # UE's minimum (MinSDKVersion); V8 defaults to 29

# --- Same as Win64 ---
is_debug = false
v8_monolithic = true
v8_use_external_startup_data = false
is_component_build = false
v8_enable_i18n_support = false       # no ICU / icudtl.dat deployment dependency
v8_enable_pointer_compression = true
v8_enable_sandbox = false            # keep raw-pointer internal fields working
use_allocator_shim = false           # don't override global operator new/delete (clashes with UE)
v8_enable_temporal_support = false   # avoids an unbundled Rust (temporal_rs) link dependency
treat_warnings_as_errors = false
symbol_level = 0

# --- C++ stdlib: compile against the NDK's static libc++ (std::__ndk1), exactly what UE links.
# V8's bundled libc++ (std::__Cr) or libstdc++ won't link into UE (getnamo/UnrealJs#14).
use_custom_libcxx = false
use_custom_libcxx_for_host = true    # host tools (mksnapshot, torque) keep Chromium's libc++
use_clang_modules = false            # Chromium precompiles its bundled libc++ as modules; breaks with NDK libc++
clang_use_chrome_plugins = false     # Chromium code-style plugins, irrelevant for a lib build
